    .hero h1 { font-family: 'Playfair Display', serif; font-size: 44px; color: var(--text-dark); text-shadow: 2px 2px 8px rgba(255,255,255,0.6); letter-spacing: 2px; margin-bottom: 8px; }
    .hero .since { font-size: 13px; color: #7a5a8a; letter-spacing: 4px; font-weight: 600; margin-bottom: 16px; }
    .hero-divider { width: 80px; height: 2px; background: linear-gradient(90deg, transparent, var(--accent), transparent); margin: 0 auto 16px; }
    .hero .tagline { font-family: 'Playfair Display', serif; font-style: italic; color: #5a3d6b; font-size: 16px; max-width: 550px; margin: 0 auto; line-height: 1.7; }
    .hero .sub-tagline { margin-top: 12px; font-size: 13px; color: var(--text-muted); letter-spacing: 1px; }
