<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tiệm Tarot Nhà Thỏ | Official</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-main: #050505;
      --bg-surface: #0a0a0c;
      --bg-card: #121214;
      --accent: #8b5cf6; 
      --accent-dark: #7c3aed;
      --accent-glow: rgba(139, 92, 246, 0.15);
      --text-main: #f4f4f5;
      --text-muted: #a1a1aa;
      --border: #27272a;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-main);
      color: var(--text-main);
      min-height: 100vh; 
      overflow-x: hidden; 
      position: relative;
    }

    .stars-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
    .star { position: absolute; width: 2px; height: 2px; background: var(--accent); border-radius: 50%; animation: twinkle var(--dur) ease-in-out infinite; opacity: 0; }
    @keyframes twinkle { 0%,100% { opacity: 0; transform: scale(0.5); } 50% { opacity: 0.6; transform: scale(1.2); } }
    
    #mouseGlow {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 1;
      background: radial-gradient(circle 250px at var(--mouse-x, 50vw) var(--mouse-y, 50vh), rgba(139, 92, 246, 0.08), transparent 80%);
    }

    .music-player { position: fixed; bottom: 20px; right: 20px; z-index: 100; background: var(--bg-card); border: 1px solid var(--border); border-radius: 30px; padding: 10px 18px; display: flex; align-items: center; gap: 10px; cursor: pointer; transition: all 0.3s; }
    .music-player:hover { border-color: var(--accent); }
    .music-icon { font-size: 16px; animation: spin 3s linear infinite; }
    .music-player.paused .music-icon { animation-play-state: paused; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .music-text { font-size: 12px; color: var(--text-muted); font-weight: 600; }

    .container { max-width: 1150px; margin: 0 auto; position: relative; z-index: 2; padding: 0 16px; }
    
    .hero { text-align: center; padding: 60px 20px 40px; margin-bottom: 30px; border-bottom: 1px solid var(--border); background: var(--bg-surface); border-radius: 0 0 30px 30px; }
    .hero-avatar-group { display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 16px; }
    .hero-avatar { width: 95px; height: 95px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); box-shadow: 0 0 25px var(--accent-glow); }
    .hero-rabbit { font-size: 45px; animation: bounceRabbit 2s ease-in-out infinite; }
    @keyframes bounceRabbit { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    .hero h1 { font-family: 'Playfair Display', serif; font-size: 38px; color: var(--text-main); letter-spacing: 1px; margin-bottom: 8px; }
    .hero .since { font-size: 12px; color: var(--accent); letter-spacing: 4px; font-weight: 600; margin-bottom: 16px; text-transform: uppercase; }
    .hero-divider { width: 60px; height: 1px; background: var(--accent); margin: 0 auto 16px; }
    .hero .tagline { font-family: 'Playfair Display', serif; font-style: italic; color: var(--text-muted); font-size: 15px; max-width: 500px; margin: 0 auto; line-height: 1.7; }

    .nav-wrapper { position: sticky; top: 0; z-index: 50; padding: 10px 0; margin-bottom: 20px; }
    .tabs { display: flex; justify-content: center; background: var(--bg-card); border: 1px solid var(--border); border-radius: 30px; padding: 6px; gap: 4px; max-width: fit-content; margin: 0 auto; }
    .tab-btn { padding: 10px 20px; border: none; background: transparent; color: var(--text-muted); font-size: 13px; font-weight: 600; cursor: pointer; border-radius: 20px; transition: 0.3s; font-family: inherit; }
    .tab-btn:hover { color: var(--text-main); }
    .tab-btn.active { background: var(--accent); color: #000; font-weight: 700; }

    .tab-content { display: none; padding: 20px 10px; animation: fadeIn 0.4s ease; }
    .tab-content.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
    .section-title { font-family: 'Playfair Display', serif; font-size: 24px; color: var(--accent); margin-bottom: 24px; text-align: center; }

    .summary-card { background: rgba(255, 255, 255, 0.02); border: 1px dashed rgba(139, 92, 246, 0.4); border-radius: 14px; padding: 20px; margin-bottom: 30px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .summary-item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; }
    .summary-item .icon { font-size: 24px; margin-bottom: 4px; }
    .summary-item .text strong { color: var(--text-main); font-size: 14px; font-weight: 600; display: block; margin-bottom: 6px; }
    .summary-item .text p { color: var(--text-muted); font-size: 12px; line-height: 1.5; }
    .candle-banner { grid-column: 1 / -1; background: linear-gradient(90deg, rgba(139,92,246,0.1), rgba(139,92,246,0.2), rgba(139,92,246,0.1)); border: 1px solid rgba(139, 92, 246, 0.3); padding: 12px; border-radius: 10px; margin-top: 8px; display: flex; justify-content: center; align-items: center; gap: 10px; font-size: 13px; color: var(--text-main); }
    .candle-banner strong { color: var(--accent); }

    .price-row-5 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 16px; }
    .price-row-2-combo { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    .price-row-2-other { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    .price-row-3-other { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 16px; }
    .price-row-1 { display: grid; grid-template-columns: 1fr; gap: 16px; margin-bottom: 16px; }
    
    .inner-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
    .inner-grid-4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 8px 16px; }

    .section-divider { border-top: 1px dashed var(--border); margin: 40px 0 30px; position: relative; text-align: center; }
    .section-divider span { background: var(--bg-main); padding: 0 20px; position: relative; top: -10px; color: var(--accent); font-size: 14px; font-weight: 600; letter-spacing: 2px; }

    .price-box { background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(139, 92, 246, 0.2); border-radius: 14px; padding: 16px; transition: 0.3s; position: relative; display: flex; flex-direction: column; }
    .price-box:hover { transform: translateY(-3px); border-color: var(--accent); box-shadow: 0 4px 15px var(--accent-glow); z-index: 5; background: var(--bg-card); }
    .price-box h3 { font-family: 'Playfair Display', serif; color: var(--text-main); font-size: 14px; margin-bottom: 16px; display: flex; align-items: center; justify-content: center; gap: 6px; font-weight: 600; border-bottom: 1px solid var(--border); padding-bottom: 10px; text-align: center; text-transform: uppercase; letter-spacing: 0.5px; }
    
    .price-row { display: flex; justify-content: space-between; align-items: center; font-size: 12px; margin-bottom: 12px; color: var(--text-muted); }
    
    @keyframes pulseGlow { 0% { box-shadow: 0 0 4px var(--accent); } 50% { box-shadow: 0 0 10px var(--accent), 0 0 15px var(--accent-dark); } 100% { box-shadow: 0 0 4px var(--accent); } }
    .price-row .name { display: flex; align-items: center; gap: 10px; }
    .price-row .name::before { content: ""; width: 6px; height: 6px; background: var(--accent); border-radius: 50%; display: inline-block; flex-shrink: 0; animation: pulseGlow 2s infinite alternate; }
    .price-row .val { color: var(--accent); font-weight: 600; white-space: nowrap; margin-left: 8px; }
    .price-note { font-size: 11px; color: rgba(161, 161, 170, 0.6); text-align: center; margin-top: -10px; margin-bottom: 12px; font-style: italic; }

    .toggle-wrapper { margin: 40px 0 20px; }
    .toggle-header { font-family: 'Playfair Display', serif; font-size: 22px; color: var(--accent); display: flex; align-items: center; justify-content: center; gap: 12px; cursor: pointer; padding: 10px; transition: 0.3s; user-select: none; letter-spacing: 1px; }
    .toggle-header:hover { text-shadow: 0 0 15px var(--accent-glow); color: #fff; }
    .toggle-header .icon-arrow { font-size: 14px; transition: transform 0.4s ease; }
    .toggle-wrapper.open .toggle-header .icon-arrow { transform: rotate(180deg); }
    .toggle-content { display: none; padding-top: 10px; animation: fadeInDown 0.4s ease; }
    .toggle-wrapper.open .toggle-content { display: block; }
    @keyframes fadeInDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

    .witchcraft-split { display: flex; gap: 20px; justify-content: space-between; }
    .col-spells, .col-rituals { flex: 1; }
    .v-divider { width: 1px; background: linear-gradient(to bottom, transparent, var(--accent-dark), transparent); opacity: 0.5; margin: 0 10px; }
    .witch-title { text-align: center; font-family: 'Playfair Display', serif; font-size: 14px; color: #fff; margin-bottom: 16px; font-style: italic; letter-spacing: 1px; }
    .banner-special { background: linear-gradient(90deg, #4c1d95, #7c3aed); color: #fff; font-size: 11px; font-weight: 700; text-align: center; padding: 8px 30px; border-radius: 20px; margin: 24px auto 0; width: fit-content; letter-spacing: 0.5px; box-shadow: 0 4px 15px var(--accent-glow); }

    /* LƯỚI ẢNH FEEDBACK MỚI NHẤT (GRID GALLERY) */
    .feed-gallery { 
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 16px;
      width: 100%;
    }
    .feed-item { 
      background: var(--bg-card); 
      border: 1px solid var(--border); 
      border-radius: 14px; 
      overflow: hidden; 
      cursor: pointer; 
      transition: 0.3s; 
      display: flex;
      flex-direction: column;
    }
    .feed-item:hover { 
      border-color: var(--accent); 
      transform: translateY(-5px); 
      box-shadow: 0 5px 15px var(--accent-glow); 
    }
    .feed-item img { 
      width: 100%; 
      height: 380px; 
      object-fit: cover; 
      display: block; 
    }
    .feed-item .caption { 
      padding: 12px; 
      font-size: 13px; 
      color: var(--text-muted); 
      text-align: center; 
      border-top: 1px solid var(--border); 
      font-style: italic; 
    }

    .clean-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 24px; margin-bottom: 20px; }
    .contact-link { display: block; width: 100%; text-align: center; padding: 14px; margin-bottom: 12px; background: var(--bg-surface); color: var(--text-main); text-decoration: none; border-radius: 12px; border: 1px solid var(--border); font-size: 14px; font-weight: 600; transition: 0.3s; }
    .contact-link:hover { background: var(--accent); color: #000; border-color: var(--accent); }

    .lightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.92); z-index: 1000; justify-content: center; align-items: center; padding: 20px; }
    .lightbox.active { display: flex; }
    .lightbox img { max-width: 95%; max-height: 85vh; border-radius: 12px; object-fit: contain; }
    .footer { text-align: center; padding: 40px 20px; margin-top: 40px; color: var(--text-muted); font-size: 12px; border-top: 1px solid var(--border); }

    @media (max-width: 950px) {
      .price-row-5, .summary-card { grid-template-columns: repeat(3, 1fr); }
      .price-row-2-combo, .price-row-2-other, .price-row-3-other { grid-template-columns: 1fr; }
      .inner-grid-4 { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      .price-row-5, .summary-card { grid-template-columns: 1fr; }
      .inner-grid-2, .inner-grid-4 { grid-template-columns: 1fr; }
      .witchcraft-split { flex-direction: column; gap: 0; }
      .v-divider { width: 100%; height: 1px; margin: 20px 0; background: linear-gradient(to right, transparent, var(--accent-dark), transparent); }
      
      /* Trên Mobile tự động chia thành 2 cột ảnh */
      .feed-gallery { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .feed-item img { height: 260px; }
    }
  </style>
</head>
