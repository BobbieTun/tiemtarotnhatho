    .legit-img { width: 150px; height: 150px; object-fit: cover; border-radius: 14px; border: 2px solid rgba(201,168,216,0.3); cursor: pointer; transition: all 0.3s; box-shadow: 0 4px 12px rgba(74,59,82,0.1); }
    .legit-img:hover { transform: scale(1.05) rotate(1deg); box-shadow: 0 8px 24px rgba(74,59,82,0.15); border-color: var(--accent); }
    .legit-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 18px; }
