    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .music-text { font-size: 12px; color: var(--text-muted); font-weight: 600; }
    .container { max-width: 1000px; margin: 0 auto; position: relative; z-index: 2; padding: 0 16px; }
    .hero { text-align: center; padding: 70px 30px 50px; position: relative; overflow: hidden; border-radius: 0 0 40px 40px; background: linear-gradient(135deg, rgba(201,168,216,0.3) 0%, rgba(232,196,217,0.3) 50%, rgba(240,213,224,0.3) 100%); backdrop-filter: blur(5px); margin-bottom: 30px; border-bottom: 1px solid rgba(255,255,255,0.6); }
