    .lightbox img { max-width: 90%; max-height: 78vh; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); border: 2px solid rgba(255,255,255,0.1); }
    .lightbox-close { position: absolute; top: 20px; right: 30px; font-size: 40px; color: #fff; cursor: pointer; opacity: 0.7; transition: opacity 0.2s; width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
    .lightbox-close:hover { opacity: 1; background: rgba(255,255,255,0.1); }
    .lightbox-caption { color: rgba(255,255,255,0.8); margin-top: 16px; font-size: 15px; text-align: center; font-family: 'Playfair Display', serif; }
    .legit-box { background: linear-gradient(135deg, rgba(201,168,216,0.2), rgba(232,196,217,0.2)); backdrop-filter: blur(10px); border-radius: 24px; padding: 40px 30px; text-align: center; border: 1px solid rgba(255,255,255,0.5); }
    .legit-box .big-number { font-family: 'Playfair Display', serif; font-size: 56px; color: var(--text-dark); font-weight: 700; text-shadow: 2px 2px 8px rgba(255,255,255,0.5); }
    .legit-box .label { color: var(--text-muted); font-size: 14px; margin-top: 8px; font-weight: 500; }
    .commit-list { list-style: none; padding: 0; margin: 0; }
    .commit-list li { padding: 12px 0; border-bottom: 1px dashed rgba(201,168,216,0.25); display: flex; align-items: center; gap: 12px; font-size: 14px; color: #5a4a6a; transition: all 0.2s; }
