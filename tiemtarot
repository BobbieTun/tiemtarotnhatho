    .section-subtitle { text-align: center; color: var(--text-muted); font-size: 14px; margin-top: -18px; margin-bottom: 28px; font-style: italic; }
    .glass-card { background: var(--card-bg); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.6); border-radius: 20px; padding: 24px; box-shadow: 0 8px 32px rgba(74,59,82,0.08); transition: all 0.4s cubic-bezier(0.4,0,0.2,1); }
