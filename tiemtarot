<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tiệm Tarot Nhà Thỏ | Official</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-main: #050505;
      --bg-surface: #0a0a0c;
      --bg-card: #121214;
      --accent: #8b5cf6; 
      --accent-dark: #7c3aed;
      --accent-glow: rgba(139, 92, 246, 0.15);
      --text-main: #f4f4f5;
      --text-muted: #a1a1aa;
      --border: #27272a;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-main);
      color: var(--text-main);
      min-height: 100vh; 
      overflow-x: hidden; 
      position: relative;
    }

    .stars-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
    .star { position: absolute; width: 2px; height: 2px; background: var(--accent); border-radius: 50%; animation: twinkle var(--dur) ease-in-out infinite; opacity: 0; }
    @keyframes twinkle { 0%,100% { opacity: 0; transform: scale(0.5); } 50% { opacity: 0.6; transform: scale(1.2); } }
    
    #mouseGlow {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 1;
      background: radial-gradient(
        circle 250px at var(--mouse-x, 50vw) var(--mouse-y, 50vh),
        rgba(139, 92, 246, 0.08),
        transparent 80%
      );
    }

    .music-player { position: fixed; bottom: 20px; right: 20px; z-index: 100; background: var(--bg-card); border: 1px solid var(--border); border-radius: 30px; padding: 10px 18px; display: flex; align-items: center; gap: 10px; cursor: pointer; transition: all 0.3s; }
    .music-player:hover { border-color: var(--accent); }
    .music-icon { font-size: 16px; animation: spin 3s linear infinite; }
    .music-player.paused .music-icon { animation-play-state: paused; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .music-text { font-size: 12px; color: var(--text-muted); font-weight: 600; }

    .container { max-width: 900px; margin: 0 auto; position: relative; z-index: 2; padding: 0 16px; }
    
    .hero { text-align: center; padding: 60px 20px 40px; margin-bottom: 30px; border-bottom: 1px solid var(--border); background: var(--bg-surface); border-radius: 0 0 30px 30px; }
    
    .hero-avatar-group { display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 16px; }
    .hero-avatar { width: 95px; height: 95px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); box-shadow: 0 0 25px var(--accent-glow); }
    .hero-rabbit { font-size: 45px; animation: bounceRabbit 2s ease-in-out infinite; }
    @keyframes bounceRabbit { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

    .hero h1 { font-family: 'Playfair Display', serif; font-size: 38px; color: var(--text-main); letter-spacing: 1px; margin-bottom: 8px; }
    .hero .since { font-size: 12px; color: var(--accent); letter-spacing: 4px; font-weight: 600; margin-bottom: 16px; text-transform: uppercase; }
    .hero-divider { width: 60px; height: 1px; background: var(--accent); margin: 0 auto 16px; }
    .hero .tagline { font-family: 'Playfair Display', serif; font-style: italic; color: var(--text-muted); font-size: 15px; max-width: 500px; margin: 0 auto; line-height: 1.7; }

    .nav-wrapper { position: sticky; top: 0; z-index: 50; padding: 10px 0; margin-bottom: 20px; }
    .tabs { display: flex; justify-content: center; background: var(--bg-card); border: 1px solid var(--border); border-radius: 30px; padding: 6px; gap: 4px; max-width: fit-content; margin: 0 auto; }
    .tab-btn { padding: 10px 20px; border: none; background: transparent; color: var(--text-muted); font-size: 13px; font-weight: 600; cursor: pointer; border-radius: 20px; transition: 0.3s; font-family: inherit; }
    .tab-btn:hover { color: var(--text-main); }
    .tab-btn.active { background: var(--accent); color: #000; font-weight: 700; }

    .tab-content { display: none; padding: 20px 10px; animation: fadeIn 0.4s ease; }
    .tab-content.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

    .section-title { font-family: 'Playfair Display', serif; font-size: 24px; color: var(--accent); margin-bottom: 24px; text-align: center; }
    .clean-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 24px; margin-bottom: 20px; transition: 0.3s; }
    
    .price-masonry { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
    .price-box { background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(139, 92, 246, 0.2); border-radius: 16px; padding: 16px; transition: 0.3s; }
    .price-box:hover { transform: translateY(-3px); border-color: var(--accent); box-shadow: 0 4px 15px var(--accent-glow); }
    .price-box h3 { font-family: 'Playfair Display', serif; color: var(--text-main); font-size: 15px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; font-weight: 600; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
    .price-row { display: flex; justify-content: space-between; align-items: center; font-size: 13px; margin-bottom: 8px; color: var(--text-muted); }
    .price-row .val { color: var(--accent); font-weight: 600; }
    .price-note { font-size: 11px; color: rgba(161, 161, 170, 0.6); text-align: center; margin-top: -6px; margin-bottom: 8px; font-style: italic; }

    /* HIỆU ỨNG ACCORDION (COMBO) */
    .combo-accordion {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(139, 92, 246, 0.4);
      border-radius: 16px;
      margin-bottom: 16px;
      overflow: hidden;
      transition: all 0.3s ease;
      grid-column: 1 / -1; /* Cho phép nó giãn full chiều rộng nếu ở trong grid */
    }
    .combo-accordion.open {
      box-shadow: 0 4px 20px var(--accent-glow);
      border-color: var(--accent);
    }
    .combo-header {
      padding: 16px 20px;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 600;
      color: var(--accent);
      background: rgba(139, 92, 246, 0.05);
      transition: 0.3s;
    }
    .combo-header:hover { background: rgba(139, 92, 246, 0.1); }
    .combo-header .icon-arrow {
      transition: transform 0.4s ease;
      font-size: 12px;
    }
    .combo-accordion.open .combo-header .icon-arrow {
      transform: rotate(180deg);
    }
    .combo-content {
      max-height: 0;
      opacity: 0;
      transition: max-height 0.5s ease, opacity 0.4s ease, padding 0.3s ease;
      padding: 0 20px;
    }
    .combo-accordion.open .combo-content {
      max-height: 1500px;
      opacity: 1;
      padding: 16px 20px 24px;
    }
    
    /* STYLE CHO 2 GÓI PRO & ELITE BÊN TRONG COMBO */
    .combo-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .combo-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      display: flex;
      flex-direction: column;
    }
    .combo-card.pro { border-top: 3px solid #71717a; } /* Màu chì cho Pro */
    .combo-card.elite { border-top: 3px solid var(--accent); box-shadow: 0 4px 15px rgba(139, 92, 246, 0.1); } /* Tím rực cho Elite */
    
    .combo-card h4 {
      text-align: center;
      margin-bottom: 4px;
      font-size: 16px;
      color: var(--text-main);
    }
    .combo-card .combo-price {
      text-align: center;
      font-size: 20px;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 16px;
      font-family: 'Playfair Display', serif;
    }
    .combo-card ul {
      list-style: none;
      padding: 0;
      font-size: 13px;
      color: var(--text-muted);
      flex-grow: 1;
    }
    .combo-card ul li {
      margin-bottom: 10px;
      padding-left: 16px;
      position: relative;
      line-height: 1.5;
    }
    .combo-card ul li::before {
      content: "✦";
      position: absolute;
      left: 0;
      color: var(--accent);
      font-size: 10px;
      top: 2px;
    }

    .feed-column { display: flex; flex-direction: column; gap: 20px; max-width: 500px; margin: 0 auto; }
    .feed-item { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; cursor: pointer; transition: 0.3s; }
    .feed-item:hover { border-color: var(--accent); transform: scale(1.02); }
    .feed-item img { width: 100%; height: auto; display: block; }
    .feed-item .caption { padding: 14px; font-size: 14px; color: var(--text-muted); text-align: center; border-top: 1px solid var(--border); font-style: italic; }

    .contact-link { display: block; width: 100%; text-align: center; padding: 14px; margin-bottom: 12px; background: var(--bg-surface); color: var(--text-main); text-decoration: none; border-radius: 12px; border: 1px solid var(--border); font-size: 14px; font-weight: 600; transition: 0.3s; }
    .contact-link:hover { background: var(--accent); color: #000; border-color: var(--accent); }

    .lightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.92); z-index: 1000; justify-content: center; align-items: center; padding: 20px; }
    .lightbox.active { display: flex; }
    .lightbox img { max-width: 95%; max-height: 85vh; border-radius: 12px; }

    .footer { text-align: center; padding: 40px 20px; margin-top: 40px; color: var(--text-muted); font-size: 12px; border-top: 1px solid var(--border); }

    @media (max-width: 600px) {
      .price-masonry { grid-template-columns: 1fr; }
      .combo-grid { grid-template-columns: 1fr; } /* Mobile xếp dọc Pro/Elite */
    }
  </style>
</head>
<body>

<div class="stars-bg" id="starsBg"></div>
