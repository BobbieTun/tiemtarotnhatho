    .glass-card .icon { font-size: 22px; }
    .price-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px dashed rgba(201,168,216,0.3); font-size: 14px; transition: all 0.2s; }
    .price-item:hover { padding-left: 8px; color: var(--text-dark); }
