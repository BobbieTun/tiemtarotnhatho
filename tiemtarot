    .legit-item:hover { transform: translateY(-6px) scale(1.02); box-shadow: 0 14px 40px rgba(74,59,82,0.18); }
    .legit-item img { width: 100%; height: 200px; object-fit: cover; display: block; transition: transform 0.5s; }
    .legit-item:hover img { transform: scale(1.1); }
    .legit-overlay { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, rgba(74,59,82,0.7)); padding: 30px 14px 14px; color: #fff; font-size: 13px; font-weight: 600; text-align: center; opacity: 0; transition: opacity 0.3s; }
    .legit-item:hover .legit-overlay { opacity: 1; }
    .lightbox { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(20,10,30,0.92); z-index: 1000; justify-content: center; align-items: center; flex-direction: column; padding: 20px; backdrop-filter: blur(10px); }
