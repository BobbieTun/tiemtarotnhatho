  <style>
    :root {
      --bg-1: #fdf6f9; --bg-2: #f5e8f0; --bg-3: #ead5e3;
      --accent: #c9a8d8; --accent-light: #e8c4d9; --accent-dark: #a67eb8;
      --text-main: #4a3b52; --text-dark: #2d1f3a; --text-muted: #8a6a9a;
      --card-bg: rgba(255,255,255,0.72); --glass: rgba(255,255,255,0.55);
      --shadow: rgba(74,59,82,0.08);
