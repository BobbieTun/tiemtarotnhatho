    .price-item .name { color: #5a4a6a; flex: 1; padding-right: 12px; font-weight: 500; }
    .price-item .price { color: var(--accent-dark); font-weight: 700; white-space: nowrap; background: linear-gradient(135deg, rgba(201,168,216,0.15), rgba(232,196,217,0.15)); padding: 4px 12px; border-radius: 20px; font-size: 13px; }
    .price-note { font-size: 12px; color: #9a7aaa; margin-bottom: 10px; font-style: italic; padding-left: 4px; }
    .price-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
    .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; }
    .legit-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 18px; margin-top: 24px; }
    .stat-item { background: var(--card-bg); backdrop-filter: blur(8px); border-radius: 16px; padding: 22px 16px; text-align: center; box-shadow: 0 4px 16px var(--shadow); border: 1px solid rgba(255,255,255,0.5); transition: transform 0.3s; }
    .stat-item:hover { transform: translateY(-4px); }
    .stat-item .num { font-family: 'Playfair Display', serif; font-size: 32px; color: var(--accent-dark); font-weight: 700; }
    .stat-item .txt { font-size: 12px; color: var(--text-muted); margin-top: 6px; font-weight: 500; }
    .about-box { line-height: 2; font-size: 15px; color: #5a4a6a; }
    .about-box p { margin-bottom: 16px; }
    .highlight { color: var(--accent-dark); font-weight: 700; background: linear-gradient(120deg, rgba(201,168,216,0.2) 0%, rgba(201,168,216,0.2) 100%); background-repeat: no-repeat; background-size: 100% 40%; background-position: 0 88%; padding: 0 4px; }
    .services-list { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
    .service-tag { background: linear-gradient(135deg, rgba(201,168,216,0.2), rgba(232,196,217,0.2)); color: #5a3d6b; padding: 8px 18px; border-radius: 25px; font-size: 13px; font-weight: 600; border: 1px solid rgba(201,168,216,0.3); transition: all 0.3s; cursor: default; }
    .service-tag:hover { background: linear-gradient(135deg, var(--accent), var(--accent-dark)); color: #fff; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(166,126,184,0.3); }
    .contact-card { text-align: center; padding: 28px 20px; }
    .contact-card .emoji { font-size: 40px; margin-bottom: 12px; display: block; }
    .contact-card h4 { margin: 0 0 8px 0; color: var(--text-dark); font-size: 15px; }
    .contact-card p { margin: 0 0 12px 0; color: var(--text-muted); font-size: 13px; }
    .contact-link { display: inline-block; padding: 10px 22px; background: linear-gradient(135deg, var(--accent), var(--accent-dark)); color: #fff; text-decoration: none; border-radius: 25px; font-size: 13px; font-weight: 700; transition: all 0.3s; box-shadow: 0 4px 15px rgba(166,126,184,0.3); position: relative; overflow: hidden; }
    .contact-link::after { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent); transition: left 0.5s; }
    .contact-link:hover::after { left: 100%; }
    .contact-link:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(166,126,184,0.4); }
    .legit-list { display: flex; flex-direction: column; gap: 18px; }
    .legit-card { background: var(--card-bg); backdrop-filter: blur(8px); border-radius: 18px; padding: 22px 24px; box-shadow: 0 4px 20px var(--shadow); border-left: 4px solid var(--accent); transition: all 0.3s; }
