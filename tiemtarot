<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🐰 Tiệm Tarot Nhà Thỏ | Since 2021</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-main: #050505;
      --bg-surface: #0a0a0c;
      --bg-card: #121214;
      --accent: #8b5cf6; 
      --accent-dark: #7c3aed;
      --accent-glow: rgba(139, 92, 246, 0.15);
      --text-main: #f4f4f5;
      --text-muted: #a1a1aa;
      --border: #27272a;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-main);
      color: var(--text-main);
      min-height: 100vh; 
      overflow-x: hidden; 
      position: relative;
    }

    .stars-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
    .star { position: absolute; width: 2px; height: 2px; background: var(--accent); border-radius: 50%; animation: twinkle var(--dur) ease-in-out infinite; opacity: 0; }
    @keyframes twinkle { 0%,100% { opacity: 0; transform: scale(0.5); } 50% { opacity: 0.6; transform: scale(1.2); } }
    
    .rabbit-float { position: fixed; font-size: 24px; pointer-events: none; z-index: 1; opacity: 0.05; animation: floatRabbit var(--dur) ease-in-out infinite; }
    @keyframes floatRabbit { 0%,100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-15px) rotate(3deg); } }
    #mouseGlow {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 1;
      background: radial-gradient(
        circle 250px at var(--mouse-x, 50vw) var(--mouse-y, 50vh),
        rgba(139, 92, 246, 0.08),
        transparent 80%
      );
    }

    .music-player { position: fixed; bottom: 20px; right: 20px; z-index: 100; background: var(--bg-card); border: 1px solid var(--border); border-radius: 30px; padding: 10px 18px; display: flex; align-items: center; gap: 10px; cursor: pointer; transition: all 0.3s; }
    .music-player:hover { border-color: var(--accent); }
    .music-icon { font-size: 16px; animation: spin 3s linear infinite; }
    .music-player.paused .music-icon { animation-play-state: paused; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .music-text { font-size: 12px; color: var(--text-muted); font-weight: 600; }

    .container { max-width: 900px; margin: 0 auto; position: relative; z-index: 2; padding: 0 16px; }
    
    .hero { text-align: center; padding: 60px 20px 40px; margin-bottom: 30px; border-bottom: 1px solid var(--border); background: var(--bg-surface); border-radius: 0 0 30px 30px; }
    .hero-rabbit { font-size: 50px; margin-bottom: 10px; animation: bounceRabbit 2s ease-in-out infinite; display: inline-block; }
    .hero-avatar-group { display: flex; aligh-items: center; justify-content: center; gap: 16px; margin-bottom: 16px; }
    .hero-avatar {width: 100px; height: 100px; border-radius: 50%; border: 2px solid var(--accent); object-fit: cover; box-shadow: 0 0 25px var(--accent-glow); }
    @keyframes bounceRabbit { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    .hero h1 { font-family: 'Playfair Display', serif; font-size: 38px; color: var(--text-main); letter-spacing: 1px; margin-bottom: 8px; }
    .hero .since { font-size: 12px; color: var(--accent); letter-spacing: 4px; font-weight: 600; margin-bottom: 16px; text-transform: uppercase; }
    .hero-divider { width: 60px; height: 1px; background: var(--accent); margin: 0 auto 16px; }
    .hero .tagline { font-family: 'Playfair Display', serif; font-style: italic; color: var(--text-muted); font-size: 15px; max-width: 500px; margin: 0 auto; line-height: 1.7; }

    .nav-wrapper { position: sticky; top: 0; z-index: 50; padding: 10px 0; margin-bottom: 20px; }
    .tabs { display: flex; justify-content: center; background: var(--bg-card); border: 1px solid var(--border); border-radius: 30px; padding: 6px; gap: 4px; max-width: fit-content; margin: 0 auto; }
    .tab-btn { padding: 10px 20px; border: none; background: transparent; color: var(--text-muted); font-size: 13px; font-weight: 600; cursor: pointer; border-radius: 20px; transition: 0.3s; font-family: inherit; }
    .tab-btn:hover { color: var(--text-main); }
    .tab-btn.active { background: var(--accent); color: #000; font-weight: 700; }

    .tab-content { display: none; padding: 20px 10px; animation: fadeIn 0.4s ease; }
    .tab-content.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

    .section-title { font-family: 'Playfair Display', serif; font-size: 24px; color: var(--accent); margin-bottom: 24px; text-align: center; }
    .clean-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 24px; margin-bottom: 20px; transition: 0.3s; }
    .clean-card:hover { border-color: var(--accent); }
    .clean-card h3 { margin: 0 0 16px 0; font-size: 16px; color: var(--text-main); display: flex; align-items: center; gap: 8px; font-weight: 600; border-bottom: 1px solid var(--border); padding-bottom: 10px; }

    .price-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
    .price-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px dashed var(--border); font-size: 14px; }
    .price-item:last-child { border-bottom: none; }
    .price-item .name { color: var(--text-muted); }
    .price-item .price { color: var(--accent); font-weight: 600; }

    .feed-column { display: flex; flex-direction: column; gap: 20px; max-width: 500px; margin: 0 auto; }
    .feed-item { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; }
    .feed-item img { width: 100%; height: auto; display: block; }
    .feed-item .caption { padding: 14px; font-size: 14px; color: var(--text-muted); text-align: center; border-top: 1px solid var(--border); font-style: italic; }

    .contact-link { display: block; width: 100%; text-align: center; padding: 14px; margin-bottom: 12px; background: var(--bg-surface); color: var(--text-main); text-decoration: none; border-radius: 12px; border: 1px solid var(--border); font-size: 14px; font-weight: 600; transition: 0.3s; }
    .contact-link:hover { background: var(--accent); color: #000; border-color: var(--accent); }

    .admin-panel { display: none; border: 1px dashed var(--accent); }
    .admin-panel.open { display: block; }
    .form-control { width: 100%; padding: 12px; background: var(--bg-main); border: 1px solid var(--border); border-radius: 8px; color: var(--text-main); margin-bottom: 12px; font-family: inherit; }
    .btn-submit { width: 100%; padding: 12px; background: var(--accent); color: #000; font-weight: 700; border: none; border-radius: 8px; cursor: pointer; }

    .footer { text-align: center; padding: 40px 20px; margin-top: 40px; color: var(--text-muted); font-size: 12px; border-top: 1px solid var(--border); }
  </style>
</head>
<body>

<div class="stars-bg" id="starsBg"></div>
<div id="mouseGlow"></div>

<div class="music-player paused" id="musicPlayer" onclick="toggleMusic()">
  <span class="music-icon">🎵</span>
  <span class="music-text" id="musicText">Play Music</span>
</div>

<audio id="bgMusic" loop>
  <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=relaxing-mountains-rivers-streams-running-water-18178.mp3" type="audio/mpeg">
</audio>

<div class="container">
  <div class="hero">
    <div class="hero-rabbit">🐰</div>
    <img src ="https://raw.githubusercontent.com/BobbieTun/tiemtarotnhatho/refs/heads/main/tarottho.png" alt="Avatar" class = "hero-avatar">
    <div class="hero-rabbit">🐰</div>
    <h1>Tiệm Tarot Nhà Thỏ</h1>
    <div class="since">Since 2021</div>
    <div class="hero-divider"></div>
    <div class="tagline">"Mỗi trải bài là một thông điệp — Mỗi câu chuyện là một hành trình chữa lành."</div>
  </div>

  <div class="nav-wrapper">
    <div class="tabs">
      <button class="tab-btn active" onclick="showTab('prices', this)">Dịch Vụ & Giá</button>
      <button class="tab-btn" onclick="showTab('feed', this)">Feed & Legit</button>
      <button class="tab-btn" onclick="showTab('contact', this)">Liên Hệ</button>
    </div>
  </div>

  <div class="clean-card admin-panel" id="adminPanel">
    <div class="section-title" style="font-size: 18px; text-align: left;">⚙️ Admin: Quản Lý Database</div>
    
    <p style="color: var(--accent); font-size: 13px; margin-bottom: 8px;">1. Thêm Dịch Vụ (Hỗ trợ nhiều dòng)</p>
    <textarea id="srvBulk" class="form-control" rows="5" placeholder="Nhập theo mẫu: Tên dịch vụ | Giá&#10;Ví dụ:&#10;Bài Tây 1 câu | 80k&#10;Tarot 30 phút | 190k&#10;Bản Đồ Sao | 390k"></textarea>
    <button class="btn-submit" onclick="addBulkServices()">Lưu Hàng Loạt Dịch Vụ</button>

    <p style="color: var(--accent); font-size: 13px; margin: 24px 0 8px;">2. Thêm Ảnh Feed / Legit</p>
    <input type="text" id="imgUrl" class="form-control" placeholder="Link ảnh trực tiếp">
    <input type="text" id="imgCaption" class="form-control" placeholder="Mô tả ảnh (Tùy chọn)">
    <button class="btn-submit" onclick="addFeed()">Tải Lên Cột Ảnh</button>
  </div>

  <div id="prices" class="tab-content active">
    <div class="section-title">Bảng Giá</div>
    <p style="text-align: center; color: var(--text-muted); font-size: 13px; margin-bottom: 24px;">Minh bạch · Công khai · Chuyên nghiệp</p>
    
    <div class="price-grid" id="serviceList">
      <div class="clean-card">
        <h3><span class="icon">🔮</span> Đang tải Menu...</h3>
      </div>
    </div>
  </div>

  <div id="feed" class="tab-content">
    <div class="section-title">Minh Chứng & Feedback</div>
    <div class="feed-column" id="feedList">
    </div>
  </div>

  <div id="contact" class="tab-content">
    <div class="section-title">Đặt Lịch</div>
    <div class="clean-card" style="text-align: center; max-width: 500px; margin: 0 auto;">
      <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 20px;">11:00 AM — 02:00 AM hàng ngày.<br>Vui lòng thanh toán trước để xác nhận lịch.</p>
      <a href="https://www.facebook.com/tiemtarotnhatho" class="contact-link">Nhắn tin qua Fanpage</a>
      <a href="https://www.instagram.com/tiemtarotnhatho06/" class="contact-link">Direct qua Instagram</a>
    </div>
  </div>

  <div class="footer">
    <div>Made by Tiệm Tarot Nhà Thỏ</div>
    <div style="margin-top: 8px; cursor: pointer; opacity: 0.5;" onclick="toggleAdmin()">[ Core Control ]</div>
  </div>
</div>

<script>
  function showTab(tabId, btn) {
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(tabId).classList.add('active');
    btn.classList.add('active');
  }

  document.addEventListener('mousemove', function(e) {
    const glow = document.getElementById('mouseGlow');
    glow.style.setProperty('--mouse-x', `${e.clientX}px`);
    glow.style.setProperty('--mouse-y', `${e.clientY}px`);
  });

  let isPlaying = true;
  function toggleMusic() {
    const music = document.getElementById('bgMusic');
    const player = document.getElementById('musicPlayer');
    if (isPlaying) { music.pause(); player.classList.add('paused'); document.getElementById('musicText').textContent = 'Play Music'; } 
    else { music.play(); player.classList.remove('paused'); document.getElementById('musicText').textContent = 'Pause'; }
    isPlaying = !isPlaying;
  }

  const starsBg = document.getElementById('starsBg');
  for (let i = 0; i < 40; i++) {
    const star = document.createElement('div');
    star.className = 'star';
    star.style.left = Math.random() * 100 + '%'; star.style.top = Math.random() * 100 + '%';
    star.style.setProperty('--dur', (2 + Math.random() * 3) + 's');
    star.style.animationDelay = Math.random() * 3 + 's';
    starsBg.appendChild(star);
  }

  const API_URL = 'https://tiemtarotnhatho.vercel.app/';

  function toggleAdmin() {
    const pass = prompt("Nhập Passcode:");
    if(pass){
      currentAdminPass = pass;
     document.getElementById('adminPanel').classList.add('open');
    }
  }

  async function loadData() {
    try {
      const resSrv = await fetch(`${API_URL}/services`);
      const services = await resSrv.json();
      
      document.getElementById('serviceList').innerHTML = `
        <div class="clean-card">
          <h3><span class="icon">🔮</span> Menu Trải Bài Tích Hợp</h3>
          ${services.map(s => `
            <div class="price-item">
              <span class="name">${s.name}</span>
              <span class="price">${s.price}</span>
            </div>
          `).join('')}
        </div>
      `;

      const resFeed = await fetch(`${API_URL}/feed`);
      const feeds = await resFeed.json();
      document.getElementById('feedList').innerHTML = feeds.map(f => `
        <div class="feed-item">
          <img src="${f.imageUrl}" alt="Feed Image">
          ${f.caption ? `<div class="caption">${f.caption}</div>` : ''}
        </div>
      `).join('');
    } catch (err) {
      document.getElementById('serviceList').innerHTML = `<div class="clean-card"><p style="color:var(--text-muted)">Chưa kết nối Backend DB.</p></div>`;
    }
  }

  async function addBulkServices() {
    const textData = document.getElementById('srvBulk').value;
    const lines = textData.split('\n');
    const promises = [];

    for (let line of lines) {
      if (!line.trim()) continue;
      let parts = line.split('|');
      if (parts.length >= 2) {
        let name = parts[0].trim();
        let price = parts[1].trim();
        promises.push(fetch(`${API_URL}/services`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, price })
        }));
      }
    }

    if (promises.length === 0) {
      alert('Vui lòng nhập đúng định dạng: Tên dịch vụ | Giá');
      return;
    }

    await Promise.all(promises);
    document.getElementById('srvBulk').value = '';
    alert(`Đã lưu ${promises.length} dịch vụ!`);
    loadData();
  }

  async function addFeed() {
    const imageUrl = document.getElementById('imgUrl').value;
    const caption = document.getElementById('imgCaption').value;
    const res = await fetch(`${API_URL}/feed`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ imageUrl, caption }) });
    await fetch(`${API_URL}/feed`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ imageUrl, caption,pass :currentAdminPass }) });
    if(res.status === 403){
      alert('Passcode không đúng! Không thể tải lên.');
      return;
    }
    alert('Đã tải ảnh lên Cột Feedback!'); 
    document.getElementById('imgUrl').value = '';
    document.getElementById('imgCaption').value = '';
    loadData();
  }
  
  loadData();
</script>

</body>
</html>
