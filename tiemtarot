    .tabs { display: flex; justify-content: center; background: var(--glass); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.5); border-radius: 50px; flex-wrap: wrap; padding: 6px; box-shadow: 0 4px 20px var(--shadow); max-width: fit-content; margin: 0 auto; }
    .tab-btn { padding: 12px 20px; border: none; background: transparent; color: var(--text-muted); font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.35s cubic-bezier(0.4,0,0.2,1); border-radius: 40px; font-family: inherit; white-space: nowrap; position: relative; overflow: hidden; }
    .tab-btn::before { content: ''; position: absolute; top: 50%; left: 50%; width: 0; height: 0; background: rgba(201,168,216,0.2); border-radius: 50%; transform: translate(-50%,-50%); transition: width 0.4s, height 0.4s; }
